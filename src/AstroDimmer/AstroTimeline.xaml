<?xml version="1.0" encoding="utf-8"?>
<!--
    Track, now marker and hour axis. The track's contents are built in code;
    see AstroTimeline.xaml.cpp for why the transition is a chequerboard.
-->
<UserControl
    x:Class="AstroDimmer.AstroTimeline"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Uid="AstroTimelineRoot"
    IsTabStop="False">

    <!-- 3 overhang + 26 track + 3 overhang + 4 gap + 14 axis -->
    <Grid x:Name="Root" Height="50">
        <Canvas x:Name="Track" Height="26" Margin="0,3,0,0" VerticalAlignment="Top" />

        <!-- Outside the track's rounded clip and overhanging it, so it stays
             legible against either colour instead of vanishing into a band. -->
        <Canvas x:Name="Overlay" />

        <Canvas x:Name="Axis" Height="14" Margin="0,36,0,0" VerticalAlignment="Top" />
    </Grid>
</UserControl>
