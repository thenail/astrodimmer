<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AstroDimmer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                The few colours Windows has no name for. Nothing here is a
                picked colour: the map uses Fluent's own tokens, and the day
                strip's bands are Glimmer's formula applied to Fluent's page
                and text colours - the day band 10% in from the bright end,
                the night band 18% in from the dim end, so neither disappears
                into the page or the text around it.

                The flyout's surfaces are Fluent's solid page colours at 88%,
                as in Glimmer: the stock layer fills are made for a layer
                inside a window, and over bare acrylic they let the wallpaper
                behind the panel set its colour.
            -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="WorldMapLandBrush" ResourceKey="TextFillColorDisabledBrush" />
                    <StaticResource x:Key="WorldMapGraticuleBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
                    <StaticResource x:Key="WorldMapNightBrush" ResourceKey="SmokeFillColorDefaultBrush" />
                    <StaticResource x:Key="WorldMapMarkerBrush" ResourceKey="AccentFillColorDefaultBrush" />
                    <SolidColorBrush x:Key="WorldMapMarkerHaloBrush" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="TimelineDayBrush" Color="#DDDDDD" />
                    <SolidColorBrush x:Key="TimelineNightBrush" Color="#7F7F7F" />
                    <SolidColorBrush x:Key="TimelineTickBrush" Color="#59868686" />
                    <StaticResource x:Key="TimelineNowBrush" ResourceKey="AccentFillColorDefaultBrush" />
                    <SolidColorBrush x:Key="TimelineNowHaloBrush" Color="#CCFFFFFF" />
                    <StaticResource x:Key="TimelineAxisBrush" ResourceKey="TextFillColorTertiaryBrush" />
                    <SolidColorBrush x:Key="FlyoutSurfaceBrush" Color="{ThemeResource SolidBackgroundFillColorBase}" Opacity="0.88" />
                    <SolidColorBrush x:Key="FlyoutFooterBrush" Color="{ThemeResource SolidBackgroundFillColorSecondary}" Opacity="0.88" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="WorldMapLandBrush" ResourceKey="TextFillColorDisabledBrush" />
                    <StaticResource x:Key="WorldMapGraticuleBrush" ResourceKey="DividerStrokeColorDefaultBrush" />
                    <StaticResource x:Key="WorldMapNightBrush" ResourceKey="SmokeFillColorDefaultBrush" />
                    <StaticResource x:Key="WorldMapMarkerBrush" ResourceKey="AccentFillColorDefaultBrush" />
                    <SolidColorBrush x:Key="WorldMapMarkerHaloBrush" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="TimelineDayBrush" Color="#E9E9E9" />
                    <SolidColorBrush x:Key="TimelineNightBrush" Color="#868686" />
                    <SolidColorBrush x:Key="TimelineTickBrush" Color="#598F8F8F" />
                    <StaticResource x:Key="TimelineNowBrush" ResourceKey="AccentFillColorDefaultBrush" />
                    <SolidColorBrush x:Key="TimelineNowHaloBrush" Color="#CCFFFFFF" />
                    <StaticResource x:Key="TimelineAxisBrush" ResourceKey="TextFillColorTertiaryBrush" />
                    <SolidColorBrush x:Key="FlyoutSurfaceBrush" Color="{ThemeResource SolidBackgroundFillColorBase}" Opacity="0.88" />
                    <SolidColorBrush x:Key="FlyoutFooterBrush" Color="{ThemeResource SolidBackgroundFillColorSecondary}" Opacity="0.88" />
                </ResourceDictionary>
                <!--
                    High contrast takes the theme's own nominated colours:
                    land as window text, the day strip as the window and
                    window-text pair the theme guarantees contrast for.
                -->
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="WorldMapLandBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="WorldMapGraticuleBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="WorldMapNightBrush" Color="{ThemeResource SystemColorHotlightColor}" Opacity="0.35" />
                    <SolidColorBrush x:Key="WorldMapMarkerBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="WorldMapMarkerHaloBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TimelineDayBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TimelineNightBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TimelineTickBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="TimelineNowBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="TimelineNowHaloBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TimelineAxisBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="FlyoutSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="FlyoutFooterBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
                A flat button that only fills on hover, as the gear in the
                Quick Settings footer does. Lightweight styling over the stock
                template, so focus visuals and pressed states stay Windows'.
            -->
            <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
            </Style>

            <!--
                Secondary caption text for elements built in code. A brush
                looked up from code is fixed to one theme; a setter's
                ThemeResource follows the element's.
            -->
            <Style x:Key="SecondaryCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SecondaryText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="DisabledText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorDisabledBrush}" />
            </Style>
            <Style x:Key="SecondaryIcon" TargetType="FontIcon">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!--
                A line across a card's body, edge to edge like the one under
                its header: the card's padding is 16, so it bleeds by that.
            -->
            <Style x:Key="CardDivider" TargetType="Border">
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="-16,0,-16,0" />
                <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            </Style>

            <!-- The heading over a group of cards, as in Windows Settings. -->
            <Style x:Key="GroupHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,28,0,6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
