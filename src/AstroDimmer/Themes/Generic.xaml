<?xml version="1.0" encoding="utf-8"?>
<!--
    Default templates for AstroDimmer's own controls. WinUI looks for this
    file at Themes/Generic.xaml by convention.

    Metrics are the Windows Community Toolkit SettingsCard's, which is what
    the Windows 11 Settings app itself is built from: 68 DIP rows, a 20 px
    glyph, 16 px padding, 4 px between cards.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AstroDimmer">

    <Style TargetType="local:SettingsCard">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SettingsCard">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <StackPanel>
                            <Grid MinHeight="{TemplateBinding MinHeight}" Padding="16,12,16,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon x:Name="PART_Icon"
                                          Glyph="{TemplateBinding Glyph}"
                                          FontSize="20"
                                          Margin="2,0,20,0"
                                          VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Header}"
                                               Style="{StaticResource BodyTextBlockStyle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="PART_Description"
                                               Text="{TemplateBinding Description}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <ContentPresenter x:Name="PART_Content"
                                                  Grid.Column="2"
                                                  Margin="16,0,0,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Right"
                                                  Content="{TemplateBinding Content}" />
                            </Grid>

                            <!--
                                Settings that belong to this row, below a
                                divider. The left edge lines up with the row's
                                glyph rather than its title: indented to the
                                title, the rows read as a sub-list hanging off
                                the name.
                            -->
                            <Border x:Name="PART_Body"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="16,14,16,16">
                                <ContentPresenter Content="{TemplateBinding Body}" />
                            </Border>

                            <!-- Content that IS the setting, under the title. -->
                            <ContentPresenter x:Name="PART_WideBody"
                                              Margin="58,0,16,16"
                                              Content="{TemplateBinding Body}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="local:OffsetStepper">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OffsetStepper">
                    <!-- The gap is for the caption: at its longest it runs
                         past the minimum width and would otherwise crowd the
                         buttons. MinWidth drops by the same amount, so a
                         short value keeps the width it had. -->
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <Button x:Name="PART_Decrease"
                                Width="32" Height="32" Padding="0"
                                x:Uid="StepperDecrease">
                            <FontIcon Glyph="&#xE738;" FontSize="12" />
                        </Button>

                        <!-- Two stacked lines: the result, then how it was reached -->
                        <StackPanel MinWidth="80" VerticalAlignment="Center">
                            <!-- Tabular figures stop the value jittering as it changes -->
                            <TextBlock Text="{TemplateBinding ValueText}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"
                                       FontSize="15"
                                       Typography.NumeralAlignment="Tabular"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding CaptionText}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="NoWrap" />
                        </StackPanel>

                        <Button x:Name="PART_Increase"
                                Width="32" Height="32" Padding="0"
                                x:Uid="StepperIncrease">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
