  </ItemGroup>
  <ItemGroup>
    <None Include="packages.config" />
    <!-- The coastline, beside the exe: read at runtime by WorldMap. -->
    <CopyFileToFolders Include="Assets\world-110m.path">
      <DestinationFolders>$(OutDir)Assets</DestinationFolders>
    </CopyFileToFolders>
    <!--
      Licence notices, shipped with the binaries as the licences require:
      ours for Natural Earth and Fluent Emoji, and each bundled package's own,
      copied from the package itself so they cannot drift from its version.
    -->
