    <ClInclude Include="Native\DdcSession.h" />
    <ClInclude Include="Native\DisplayInfo.h" />
    <ClInclude Include="Native\Backlight.h" />
    <ClInclude Include="Native\Shell.h" />
    <ClInclude Include="Native\SystemEvents.h" />
    <ClInclude Include="Displays\AstroRunner.h" />
    <ClInclude Include="Displays\DisplayItem.h" />
    <ClInclude Include="Displays\DisplayService.h" />
    <ClInclude Include="Controls\OffsetStepper.h">
      <DependentUpon>Controls\OffsetStepper.idl</DependentUpon>
    </ClInclude>
    <ClInclude Include="Controls\SettingsCard.h">
      <DependentUpon>Controls\SettingsCard.idl</DependentUpon>
    </ClInclude>
    <ClInclude Include="App.xaml.h">
      <DependentUpon>App.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="AstroTimeline.xaml.h">
      <DependentUpon>AstroTimeline.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="FlyoutWindow.xaml.h">
