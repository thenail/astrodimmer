#include "AppIcon.h"

// The desktop computer from Microsoft's Fluent Emoji (MIT); see THIRD-PARTY-NOTICES.txt.
IDI_APP ICON "Assets/AstroDimmer.ico"

// The name Windows shows for the exe: Task Manager, the startup apps list,
// and the file's properties. Without it they fall back to "AstroDimmer.exe".
1 VERSIONINFO
FILEVERSION 1,5,1,0
PRODUCTVERSION 1,5,1,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Astro Dimmer"
            VALUE "ProductName", "Astro Dimmer"
            VALUE "FileVersion", "1.5.1.0"
            VALUE "ProductVersion", "1.5.1.0"
            VALUE "OriginalFilename", "AstroDimmer.exe"
            VALUE "InternalName", "AstroDimmer"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
